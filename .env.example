# Generate secrets locally; never commit .env or authenticated browser archives.
OTP_RETRIEVAL_TOKEN=
OTP_RETRIEVAL_KEY=
OTP_BIND_HOST=127.0.0.1
PORT=3010
MAX_ACTIVE_BROWSERS=2
MAX_QUEUED_LOOKUPS=50
MAX_PROFILE_QUEUE=5
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Empty uses %LOCALAPPDATA%\OTP-Retrieval\state.sqlite on Windows.
OTP_STATE_DB=
OTP_PROFILE_ROOT=C:\Users\nebula\otp-browser-profiles
